# BullMQ backend (Valkey is a drop-in, fully Redis-compatible server).
REDIS_URL=redis://localhost:6379

# Queue consumed by this worker.
RESUME_QUEUE_NAME=resume-processing
WORKER_CONCURRENCY=2

# Python AI service (server-only).
# Do NOT expose these with a NEXT_PUBLIC_ prefix.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-secret-key

# Convex HTTP actions site URL + shared secret used to persist results.
CONVEX_SITE_URL=
WORKER_SERVICE_KEY=
