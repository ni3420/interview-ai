# BullMQ backend (Valkey is a drop-in, fully Redis-compatible server).
REDIS_URL=redis://localhost:6379

# Queues consumed by this worker.
RESUME_QUEUE_NAME=resume-processing
REPORT_QUEUE_NAME=report-evaluation
WORKER_CONCURRENCY=2
REPORT_WORKER_CONCURRENCY=1

# Upper bound for the AI evaluation call. Local CPU inference can take minutes.
REPORT_AI_REQUEST_TIMEOUT_MS=900000

# Python AI service (server-only).
# Do NOT expose these with a NEXT_PUBLIC_ prefix.
# AI_SERVICE_API_KEY is required and must match SERVICE_API_KEY in the AI
# service. The worker refuses to start without it.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# Convex HTTP actions site URL + shared secret used to persist results.
# WORKER_SERVICE_KEY is required and must match the key set on the Convex
# deployment. The worker refuses to start without it.
CONVEX_SITE_URL=
WORKER_SERVICE_KEY=
