# AI Service Configuration
APP_NAME="Interview AI Service"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Service-to-service authentication. Required; there is no default.
# Must match AI_SERVICE_API_KEY in the client and worker environments.
# Generate one with: openssl rand -hex 32
SERVICE_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# --- Model provider (resume plans + report evaluation) -----------------------
# "ollama" (local, default) or "gemini" (remote).
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=900

# Gemini API (get from https://aistudio.google.com/app/apikey).
# Required for the live AI interviewer (Gemini Live), even when AI_PROVIDER=ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
# Token prices in USD per 1M tokens, used only to estimate cost in model-usage
# logs. Leave unset to log estimatedCostUsd: null. The values below are format
# examples, not current prices: verify them on the provider's pricing page.
# GEMINI_INPUT_PRICE_PER_1M=0.30
# GEMINI_OUTPUT_PRICE_PER_1M=2.50

# --- Resume processing / vector retrieval ------------------------------------
# Development embeddings run locally through Ollama; no cloud key is needed.
# Keep MODEL, DIMENSION and CONFIG_VERSION in lockstep: changing any of them
# requires re-indexing, because vectors from different models cannot be mixed.
# The Qdrant collection's vector size is validated against EMBEDDING_DIMENSION.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resume_chunks
# ollama is the only provider in development; it needs no cloud key.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_CONFIG_VERSION=v1
RESUME_MAX_BYTES=5242880

# --- Realtime vision agent ---------------------------------------------------
# Stream credentials let the AI interviewer join the interview's video call.
# These are server-only and must never be exposed to the browser.
# In Docker these are read from the repository root .env as well.
STREAM_API_KEY=
STREAM_API_SECRET=
# Gemini Live model used for speech-to-speech. Reads GEMINI_API_KEY above.
REALTIME_MODEL=gemini-3.1-flash-live-preview
REALTIME_AGENT_USER_ID=ai-interviewer
REALTIME_AGENT_USER_NAME=AI Interviewer
REALTIME_MAX_RESUME_CHARS=6000
REALTIME_MAX_QUESTIONS=25
# The realtime dependency is installed with INSTALL_REALTIME=true when building
# the image (or `pip install ".[realtime]"` for a local venv).
