# AI Service Configuration
APP_NAME="Interview AI Service"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Service-to-service authentication. Required; there is no default.
# Must match AI_SERVICE_API_KEY in the client and worker environments.
# Generate one with: openssl rand -hex 32
SERVICE_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# --- Model provider (resume plans + report evaluation) -----------------------
# "tokenharbor" (remote, default), "gemini" (remote) or "ollama" (local).
# Any registered adapter name is valid; see app/ai/providers.
AI_PROVIDER=tokenharbor
# Optional: switch to this provider on quota/5xx/timeout. Leave empty to fail
# the request instead. Set to ollama to keep a local fallback.
AI_FALLBACK_PROVIDER=
# specific = AI_PROVIDER, with AI_FALLBACK_PROVIDER on availability failures
# any      = first configured, healthy provider in AI_PROVIDER_ORDER
# all      = every configured provider, normalized into one batch
AI_PROVIDER_MODE=specific
# Comma-separated candidate order for any/all. Empty = every registered
# provider (primary first). Example: tokenharbor,gemini,ollama
AI_PROVIDER_ORDER=
# 0 keeps each adapter's own timeout (Ollama's local budget is 900s).
AI_PROVIDER_TIMEOUT_SECONDS=0
# Health probes are cached so any-mode does not probe on every request.
AI_HEALTH_CHECK_TTL_SECONDS=30
AI_HEALTH_CHECK_TIMEOUT_SECONDS=3

# TokenHarbor exposes an OpenAI-compatible /chat/completions endpoint.
# Create a key in the TokenHarbor dashboard and set it here; never commit it.
# The account must be email-verified first, or the API returns 403.
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
TOKENHARBOR_TEMPERATURE=0.7
# Reasoning and answer tokens share this budget. Too low a value can return an
# empty answer after reasoning alone (finish_reason=length).
TOKENHARBOR_MAX_TOKENS=8192
TOKENHARBOR_TIMEOUT_SECONDS=120
# Optional USD per 1M tokens for usage-log cost estimates. The free model can
# use 0; leave unset to log estimatedCostUsd: null.
# TOKENHARBOR_INPUT_PRICE_PER_1M=0
# TOKENHARBOR_OUTPUT_PRICE_PER_1M=0

# Local Ollama, also used for resume embeddings. Set
# AI_FALLBACK_PROVIDER=ollama to keep it as a chat fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=900

# Gemini API (get from https://aistudio.google.com/app/apikey).
# Required for the live AI interviewer (Gemini Live), regardless of AI_PROVIDER.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
# Token prices in USD per 1M tokens, used only to estimate cost in model-usage
# logs. Leave unset to log estimatedCostUsd: null. The values below are format
# examples, not current prices: verify them on the provider's pricing page.
# GEMINI_INPUT_PRICE_PER_1M=0.30
# GEMINI_OUTPUT_PRICE_PER_1M=2.50

# --- Resume processing / vector retrieval ------------------------------------
# Keep PROVIDER, MODEL, DIMENSION and CONFIG_VERSION in lockstep: changing any
# of them requires re-indexing into a NEW collection, because vectors from
# different models cannot be mixed. A same-dimension swap (nomic-embed-text
# 768-d -> bge-base 768-d) is NOT detected by the collection dimension check,
# so EMBEDDING_CONFIG_VERSION and QDRANT_COLLECTION must move together.
# The Qdrant collection's vector size is validated against EMBEDDING_DIMENSION.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resume_chunks_v2
# ollama needs no cloud key and stays the fallback for offline development and
# tests. cloudflare calls a deployed Worker that runs Workers AI BGE-base, so
# no Cloudflare account token is stored in this service.
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_CONFIG_VERSION=v2
# Deployed Worker endpoint, and the bearer secret that must equal the Worker's
# own API_SECRET. Set the key yourself; never commit or share its value.
EMBEDDING_WORKER_URL=
EMBEDDING_WORKER_API_KEY=
# Chunks per request and the per-request HTTP budget.
EMBEDDING_WORKER_BATCH_SIZE=32
EMBEDDING_WORKER_TIMEOUT_SECONDS=30
RESUME_MAX_BYTES=5242880

# --- Realtime vision agent ---------------------------------------------------
# Stream credentials let the AI interviewer join the interview's video call.
# These are server-only and must never be exposed to the browser.
# In Docker these are read from the repository root .env as well.
STREAM_API_KEY=
STREAM_API_SECRET=
# Gemini Live model used for speech-to-speech. Reads GEMINI_API_KEY above.
REALTIME_MODEL=gemini-3.1-flash-live-preview
REALTIME_AGENT_USER_ID=ai-interviewer
REALTIME_AGENT_USER_NAME=AI Interviewer
REALTIME_MAX_RESUME_CHARS=6000
REALTIME_MAX_QUESTIONS=25
# The realtime dependency is installed with INSTALL_REALTIME=true when building
# the image (or `pip install ".[realtime]"` for a local venv).
