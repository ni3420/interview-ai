# AI Service Configuration
APP_NAME="Interview AI Service"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Service-to-service authentication (must match the web/worker config).
SERVICE_API_KEY=dev-secret-key-change-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# --- Model provider (resume plans + report evaluation) -----------------------
# "ollama" (local, default) or "gemini" (remote).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=900

# Gemini API (get from https://aistudio.google.com/app/apikey).
# Required for the live AI interviewer (Gemini Live), even when AI_PROVIDER=ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# --- Resume processing / vector retrieval ------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resume_chunks
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_CONFIG_VERSION=v1
RESUME_MAX_BYTES=5242880

# --- Realtime vision agent ---------------------------------------------------
# Stream credentials let the AI interviewer join the interview's video call.
# These are server-only and must never be exposed to the browser.
# In Docker these are read from the repository root .env as well.
STREAM_API_KEY=
STREAM_API_SECRET=
# Gemini Live model used for speech-to-speech. Reads GEMINI_API_KEY above.
REALTIME_MODEL=gemini-3.1-flash-live-preview
REALTIME_AGENT_USER_ID=ai-interviewer
REALTIME_AGENT_USER_NAME=AI Interviewer
REALTIME_MAX_RESUME_CHARS=6000
REALTIME_MAX_QUESTIONS=25
# The realtime dependency is installed with INSTALL_REALTIME=true when building
# the image (or `pip install ".[realtime]"` for a local venv).
